---
import { getCollection, render } from 'astro:content';
import { getSortedPosts, postPath } from '../lib/posts';
import PostLayout from '../layouts/PostLayout.astro';
import PageLayout from '../layouts/PageLayout.astro';
import SplashPageLayout from '../layouts/SplashPageLayout.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getSortedPosts();
  const pages = await getCollection('pages');

  const postPaths = posts.map((post) => ({
    params: { path: postPath(post).replace(/^\/|\/$/g, '') },
    props: { kind: 'post' as const, id: post.id },
  }));

  const pagePaths = pages.map((page) => ({
    params: { path: page.data.permalink.replace(/^\/|\/$/g, '') },
    props: { kind: 'page' as const, id: page.id },
  }));

  // jekyll-paginate leftover: keep /page2/ alive, pointing home.
  const misc = [{ params: { path: 'page2' }, props: { kind: 'page2' as const } }];

  return [...postPaths, ...pagePaths, ...misc];
}

const props = Astro.props as
  | { kind: 'post'; id: string }
  | { kind: 'page'; id: string }
  | { kind: 'page2' };

let Content: any = null;
let post: any = null;
let page: any = null;

if (props.kind === 'post') {
  const all = await getCollection('posts');
  post = all.find((p) => p.id === props.id)!;
  Content = (await render(post)).Content;
} else if (props.kind === 'page') {
  const all = await getCollection('pages');
  page = all.find((p) => p.id === props.id)!;
  Content = (await render(page)).Content;
}
---

{
  props.kind === 'post' && (
    <PostLayout post={post}>
      <Content />
    </PostLayout>
  )
}

{
  props.kind === 'page' && page.data.layout === 'splash' && (
    <SplashPageLayout title={page.data.title} features={page.data.feature_row}>
      <Content />
    </SplashPageLayout>
  )
}

{
  props.kind === 'page' && page.data.layout !== 'splash' && (
    <PageLayout title={page.data.title}>
      <Content />
    </PageLayout>
  )
}

{
  props.kind === 'page2' && (
    <BaseLayout title="Eyeregulus" description="">
      <main class="shell">
        <p class="pageintro">
          <a href="/">Eyeregulus 홈으로 →</a>
        </p>
      </main>
    </BaseLayout>
  )
}
