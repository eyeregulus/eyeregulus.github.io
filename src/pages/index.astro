---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  SITE,
  TAGLINE,
  INTRO,
  APPS,
  CATEGORY_DESC,
  CATEGORY_ORDER,
  categorySlug,
  encodeHref,
} from '../consts';
import { getSortedPosts } from '../lib/posts';

const posts = await getSortedPosts();
const counts = new Map<string, number>();
for (const p of posts) {
  for (const c of p.data.categories) counts.set(c, (counts.get(c) ?? 0) + 1);
}
const categories = [
  ...CATEGORY_ORDER.filter((c) => counts.has(c)),
  ...[...counts.keys()].filter((c) => !CATEGORY_ORDER.includes(c)),
];
---

<BaseLayout title={SITE.title} description={INTRO} ogImage={SITE.defaultOgImage} isHome={true}>
  <main class="shell">
    <div class="pageintro">
      <h1>{TAGLINE}</h1>
      <p>{INTRO}</p>
    </div>

    <section class="home-sec">
      <h2 class="home-h">만든 앱</h2>
      <div class="apps">
        {
          APPS.map((app) => (
            <div class="app">
              <img
                class="app__mark"
                src={app.icon}
                alt=""
                width="120"
                height="120"
                loading="lazy"
              />
              <div>
                <a href={app.links[0].url} class="app__name">
                  {app.name}
                </a>
                <p class="app__desc">{app.desc}</p>
              </div>
              <div class="app__links">
                {app.links.map((l) => (
                  <a
                    href={encodeHref(l.url)}
                    {...(l.url.startsWith('http')
                      ? { target: '_blank', rel: 'noopener noreferrer' }
                      : {})}
                  >
                    {l.label}
                  </a>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <section>
      <h2 class="home-h">글 읽기</h2>
      <nav class="cats" aria-label="갈래">
        {
          categories.map((name) => (
            <a class="cat" href={`/categories/${categorySlug(name)}/`}>
              <span class="cat__name">{name}</span>
              <span class="cat__count">{counts.get(name)}편</span>
              {CATEGORY_DESC[name] && (
                <span class="cat__desc">{CATEGORY_DESC[name]}</span>
              )}
            </a>
          ))
        }
      </nav>
    </section>
  </main>
</BaseLayout>
