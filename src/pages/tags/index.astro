---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sidebar from '../../components/Sidebar.astro';
import ArchiveSingle from '../../components/ArchiveSingle.astro';
import { getSortedPosts } from '../../lib/posts';
import { slugify } from '../../consts';

const posts = await getSortedPosts();

const chronological = [...posts].reverse();
const firstSeen = new Map<string, number>();
let seq = 0;
for (const p of chronological) {
  for (const t of p.data.tags) if (!firstSeen.has(t)) firstSeen.set(t, seq++);
}

const tagMap = new Map<string, typeof posts>();
for (const p of posts) {
  for (const t of p.data.tags) {
    if (!tagMap.has(t)) tagMap.set(t, []);
    tagMap.get(t)!.push(p);
  }
}

const entries = [...tagMap.entries()]
  .map(([name, tagPosts]) => ({
    name,
    posts: tagPosts,
    count: tagPosts.length,
    slug: slugify(name),
  }))
  .sort(
    (a, b) =>
      b.count - a.count || firstSeen.get(a.name)! - firstSeen.get(b.name)!,
  );
---

<BaseLayout title="태그" description="아이레굴루스 글을 태그별로 모아봅니다.">
  <div class="shell shell--split">
    <Sidebar />
    <main>
      <h1 class="page-title" id="page-title">태그</h1>

      <p class="tags" style="margin-top:0;border:0;padding-top:0">
        {entries.map((e) => <a href={`#${e.slug}`} set:text={`${e.name} ${e.count}`} />)}
      </p>

      {
        entries.map((e) => (
          <section id={e.slug} style="margin-top:2.5rem">
            <h2 class="home-h" style="font-size:1.05rem">{e.name}</h2>
            <div class="list">
              {e.posts.map((post) => (
                <ArchiveSingle post={post} />
              ))}
            </div>
          </section>
        ))
      }
    </main>
  </div>
</BaseLayout>
