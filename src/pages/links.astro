---
import BaseLayout from '../layouts/BaseLayout.astro';
import { PROFILE, HUB_LINKS, encodeHref } from '../consts';
import { profilePageSchema } from '../lib/schema';

const title = `${PROFILE.displayName} — 링크`;
const description =
  `${PROFILE.displayName}(아이레굴루스) 공식 링크. 현대점성학·수비학 블로그, ` +
  '직접 만든 점성 앱, YouTube 채널.';

const href = (url: string) => (url.startsWith('/') ? encodeHref(url) : url);
const external = (url: string) => url.startsWith('http');
---

<BaseLayout title={title} description={description} jsonLd={profilePageSchema()}>
  <main class="shell hub">
    <img
      class="hub__avatar"
      src={PROFILE.avatar}
      alt={PROFILE.displayName}
      width="80"
      height="80"
    />
    <h1 class="hub__name">{PROFILE.displayName}</h1>
    <p class="hub__tag">{PROFILE.tagline}</p>

    <nav class="hub__links" aria-label="링크">
      {
        HUB_LINKS.map((l) => (
          <a
            class="hub__link"
            href={href(l.url)}
            {...(external(l.url)
              ? { target: '_blank', rel: 'noopener noreferrer' }
              : {})}
          >
            {l.label}
          </a>
        ))
      }
    </nav>

    <a class="hub__foot" href="/">eyeregulus.dev</a>
  </main>
</BaseLayout>
