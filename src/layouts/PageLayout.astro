---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}
const { title, description, ogImage } = Astro.props;
---

<BaseLayout title={title} description={description} ogImage={ogImage}>
  <main class="shell">
    <h1 class="page-title">{title}</h1>
    <div class="prose">
      <slot />
    </div>
  </main>
</BaseLayout>
