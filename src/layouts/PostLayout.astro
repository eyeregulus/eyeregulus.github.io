---
import { SITE, slugify } from '../consts';
import {
  getSortedPosts,
  postHref,
  readTime,
  excerptText,
  categorySlug,
  type Post,
} from '../lib/posts';
import BaseLayout from './BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';
import FeatureRow from '../components/FeatureRow.astro';
import { postSchema } from '../lib/schema';

interface Props {
  post: Post;
}
const { post } = Astro.props;
const { title, date, updated, tags, categories, feature_row } = post.data;

const all = await getSortedPosts();
const idx = all.findIndex((p) => p.id === post.id);
const olderPost = all[idx + 1];
const newerPost = all[idx - 1];

const category = categories[0];
const description = post.data.description ?? excerptText(post, 160);
const href = postHref(post);
const categoryUrl = category ? `/categories/${categorySlug(category)}/` : undefined;

const toIso = (d: Date) =>
  `${d.getUTCFullYear()}-${String(d.getUTCMonth() + 1).padStart(2, '0')}-${String(
    d.getUTCDate(),
  ).padStart(2, '0')}T00:00:00+00:00`;
const iso = toIso(date);
const isoMod = updated ? toIso(updated) : undefined;
const dateStr = `${date.getUTCFullYear()}. ${date.getUTCMonth() + 1}. ${date.getUTCDate()}.`;

const sortedTags = [...tags].sort((a, b) => a.localeCompare(b, 'ko'));
const ogImage = feature_row?.[0]?.image_path;

const jsonLd = postSchema({
  title,
  description,
  url: href,
  datePublished: iso,
  dateModified: isoMod,
  image: ogImage,
  category,
  categoryUrl,
});
---

<BaseLayout
  title={title}
  description={description}
  ogImage={ogImage}
  ogType="article"
  publishedTime={iso}
  modifiedTime={isoMod}
  jsonLd={jsonLd}
>
  <div class="shell shell--split">
    <Sidebar activeCategory={category} />

    <article>
      {category && <a class="article__cat" href={`/categories/${categorySlug(category)}/`}>{category}</a>}
      <h1 class="article__title">{title}</h1>
      <p class="article__meta">{SITE.name} · {dateStr} · {readTime(post)}</p>

      <div class="prose">
        {feature_row && <FeatureRow features={feature_row} />}
        <slot />
      </div>

      {
        sortedTags.length > 0 && (
          <div class="tags">
            {sortedTags.map((t) => (
              <a href={`/tags/#${slugify(t)}`} set:text={t} />
            ))}
          </div>
        )
      }

      {
        (olderPost || newerPost) && (
          <nav class="pn">
            {olderPost ? (
              <a href={postHref(olderPost)}>
                <span class="k">이전</span>
                {olderPost.data.title}
              </a>
            ) : (
              <span />
            )}
            {newerPost ? (
              <a href={postHref(newerPost)} class="r">
                <span class="k">다음</span>
                {newerPost.data.title}
              </a>
            ) : (
              <span />
            )}
          </nav>
        )
      }
    </article>
  </div>
</BaseLayout>
