---
import { SITE, slugify } from '../consts';
import {
  getSortedPosts,
  postHref,
  readTime,
  excerptText,
  categorySlug,
  type Post,
} from '../lib/posts';
import BaseLayout from './BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';
import FeatureRow from '../components/FeatureRow.astro';

interface Props {
  post: Post;
}
const { post } = Astro.props;
const { title, date, tags, categories, feature_row } = post.data;

const all = await getSortedPosts();
const idx = all.findIndex((p) => p.id === post.id);
const olderPost = all[idx + 1];
const newerPost = all[idx - 1];

const category = categories[0];
const description = excerptText(post, 200);

const pad = (n: number) => String(n).padStart(2, '0');
const iso = `${date.getUTCFullYear()}-${pad(date.getUTCMonth() + 1)}-${pad(date.getUTCDate())}T00:00:00+00:00`;
const dateStr = `${date.getUTCFullYear()}. ${date.getUTCMonth() + 1}. ${date.getUTCDate()}.`;

const sortedTags = [...tags].sort((a, b) => a.localeCompare(b, 'ko'));
const ogImage = feature_row?.[0]?.image_path;
---

<BaseLayout
  title={title}
  description={description}
  ogImage={ogImage}
  ogType="article"
  publishedTime={iso}
>
  <div class="shell shell--split">
    <Sidebar activeCategory={category} />

    <article>
      {category && <a class="article__cat" href={`/categories/${categorySlug(category)}/`}>{category}</a>}
      <h1 class="article__title">{title}</h1>
      <p class="article__meta">{SITE.name} · {dateStr} · {readTime(post)}</p>

      <div class="prose">
        {feature_row && <FeatureRow features={feature_row} />}
        <slot />
      </div>

      {
        sortedTags.length > 0 && (
          <div class="tags">
            {sortedTags.map((t) => (
              <a href={`/tags/#${slugify(t)}`} set:text={t} />
            ))}
          </div>
        )
      }

      {
        (olderPost || newerPost) && (
          <nav class="pn">
            {olderPost ? (
              <a href={postHref(olderPost)}>
                <span class="k">이전</span>
                {olderPost.data.title}
              </a>
            ) : (
              <span />
            )}
            {newerPost ? (
              <a href={postHref(newerPost)} class="r">
                <span class="k">다음</span>
                {newerPost.data.title}
              </a>
            ) : (
              <span />
            )}
          </nav>
        )
      }
    </article>
  </div>
</BaseLayout>
