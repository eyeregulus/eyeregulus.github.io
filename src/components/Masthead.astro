---
import { MAIN_NAV } from '../consts';
const path = Astro.url.pathname;
---

<header class="masthead">
  <div class="masthead__in">
    <a href="/" class="brand">Eye<span class="r">regulus</span></a>
    <nav>
      {
        MAIN_NAV.map((link) =>
          link.external ? (
            <a href={link.url} target="_blank" rel="noopener noreferrer">
              {link.title}
            </a>
          ) : (
            <a
              href={link.url}
              aria-current={path === link.url ? 'page' : undefined}
            >
              {link.title}
            </a>
          ),
        )
      }
    </nav>
  </div>
</header>
