---
import privacyHtml from './privacy-modal.html?raw';
import termsHtml from './terms-modal.html?raw';
---

<Fragment set:html={privacyHtml} />
<Fragment set:html={termsHtml} />

<style is:global>
  .privacy-modal {
    display: none;
    position: fixed;
    z-index: 9999;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    overflow: auto;
    background-color: rgba(3, 4, 7, 0.7);
  }

  .privacy-modal-content {
    background-color: var(--panel, #14161d);
    margin: 5% auto;
    padding: 24px 28px;
    border: 1px solid var(--border, #242832);
    width: 90%;
    max-width: 760px;
    max-height: 82vh;
    overflow-y: auto;
    border-radius: 6px;
    color: var(--text, #aeb6c6);
    text-align: left;
    font-size: 0.95rem;
    line-height: 1.7;
  }

  .privacy-modal-content h2,
  .privacy-modal-content h3 {
    font-family: var(--serif-kr, serif);
    color: var(--head, #e7e3d8);
  }

  .privacy-modal-content a {
    color: var(--gold, #d2a24e);
  }

  .privacy-modal-content strong {
    color: var(--head, #e7e3d8);
  }

  .privacy-close {
    color: var(--dim, #7b8394);
    float: right;
    font-size: 28px;
    font-weight: bold;
    line-height: 1;
  }

  .privacy-close:hover,
  .privacy-close:focus {
    color: var(--gold-bright, #e6ba6b);
    text-decoration: none;
    cursor: pointer;
  }

  .privacy-text h3 {
    margin-top: 24px;
    border-bottom: 1px solid var(--border, #242832);
    padding-bottom: 6px;
  }

  .privacy-table {
    width: 100%;
    border-collapse: collapse;
    margin: 15px 0;
  }

  .privacy-table th,
  .privacy-table td {
    border: 1px solid var(--border, #242832);
    padding: 8px;
    text-align: left;
  }

  .privacy-table th {
    background-color: var(--bg-deep, #07090d);
    color: var(--head, #e7e3d8);
  }
</style>

<script is:inline>
  function openPrivacyModal() {
    document.getElementById('privacyPolicyModal').style.display = 'block';
  }
  function closePrivacyModal() {
    document.getElementById('privacyPolicyModal').style.display = 'none';
  }
  function openTermsModal() {
    document.getElementById('termsOfServiceModal').style.display = 'block';
  }
  function closeTermsModal() {
    document.getElementById('termsOfServiceModal').style.display = 'none';
  }
  window.addEventListener('click', function (event) {
    var p = document.getElementById('privacyPolicyModal');
    var t = document.getElementById('termsOfServiceModal');
    if (event.target === p) p.style.display = 'none';
    if (event.target === t) t.style.display = 'none';
  });
</script>
