---
import { getSortedPosts, categorySlug } from '../lib/posts';

const posts = await getSortedPosts();
const counts = new Map<string, number>();
for (const p of posts) {
  for (const c of p.data.categories) counts.set(c, (counts.get(c) ?? 0) + 1);
}
// Jekyll: `site.categories | sort` -> by category name ascending.
const categories = [...counts.keys()].sort((a, b) => a.localeCompare(b, 'ko'));
---

{
  categories.length > 0 && (
    <>
      <h3>Categories</h3>
      <ul class="nav__items">
        {categories.map((name) => (
          <li>
            <a href={`/categories/${categorySlug(name)}/`}>
              {name} ({counts.get(name)})
            </a>
          </li>
        ))}
      </ul>
    </>
  )
}
