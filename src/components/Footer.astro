---
import { SITE, YOUTUBE_URL } from '../consts';
import Modals from './Modals.astro';

const year = new Date().getFullYear();
// Same hits.sh key as the old site so the running total carries over.
const hits =
  'https://hits.sh/Eyeregulus.github.io.svg?style=flat-square&label=%EB%B0%A9%EB%AC%B8&labelColor=15171d&color=8a6f43&view=today-total';
---

<footer class="foot">
  <div class="foot__in">
    <span>&copy; {year} {SITE.title}</span>
    <span>
      <a href={YOUTUBE_URL} target="_blank" rel="noopener noreferrer">YouTube</a> &nbsp;
      <a href="mailto:eyeregulus@gmail.com">Email</a> &nbsp;
      <a href="https://x.com/ain_alion20462" rel="me">Twitter</a> &nbsp;
      <a href="#" onclick="openPrivacyModal(); return false;">개인정보처리방침</a> &nbsp;
      <a href="#" onclick="openTermsModal(); return false;">이용약관</a>
    </span>
  </div>
  <div class="foot__hits">
    <a href="https://hits.sh/Eyeregulus.github.io/" rel="nofollow">
      <img src={hits} alt="방문자 수" width="126" height="20" loading="lazy" />
    </a>
  </div>
</footer>

<Modals />
