---
import { SITE, YOUTUBE_URL, X_URL, GOATCOUNTER_CODE } from '../consts';
import Modals from './Modals.astro';

const year = new Date().getFullYear();
const countUrl = `https://${GOATCOUNTER_CODE}.goatcounter.com/counter/TOTAL.json`;
---

<footer class="foot">
  <div class="foot__in">
    <span>&copy; {year} {SITE.title}</span>
    <span>
      <a href="/links/">링크 모음</a> &nbsp;
      <a href={YOUTUBE_URL} target="_blank" rel="noopener noreferrer">YouTube</a> &nbsp;
      <a href="mailto:eyeregulus@gmail.com">Email</a> &nbsp;
      <a href={X_URL} target="_blank" rel="me noopener noreferrer">X</a> &nbsp;
      <a href="#" onclick="openPrivacyModal(); return false;">개인정보처리방침</a> &nbsp;
      <a href="#" onclick="openTermsModal(); return false;">이용약관</a>
    </span>
  </div>
  <div class="foot__hits">
    <span id="visit-count" data-src={countUrl} hidden>방문 <b>–</b></span>
  </div>
</footer>

<script is:inline>
  (function () {
    var el = document.getElementById('visit-count');
    if (!el) return;
    fetch(el.dataset.src)
      .then(function (r) {
        return r.ok ? r.json() : null;
      })
      .then(function (d) {
        var n = d && (d.count_unique || d.count);
        if (n) {
          el.querySelector('b').textContent = String(n).trim();
          el.hidden = false;
        }
      })
      .catch(function () {});
  })();
</script>

<Modals />
