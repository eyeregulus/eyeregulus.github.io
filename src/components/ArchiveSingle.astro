---
import type { Post } from '../lib/posts';
import { postHref, excerptText } from '../lib/posts';

interface Props {
  post: Post;
  showExcerpt?: boolean;
}
const { post, showExcerpt = false } = Astro.props;

const url = postHref(post);
const d = post.data.date;
const dateStr = `${d.getUTCFullYear()}. ${d.getUTCMonth() + 1}. ${d.getUTCDate()}.`;
const excerpt = post.data.feature_row?.[0]?.title ?? excerptText(post, 140);
---

<a class="item" href={url}>
  <span class="item__date">{dateStr}</span>
  <span class="item__title">{post.data.title}</span>
  {showExcerpt && excerpt && <span class="item__excerpt">{excerpt}</span>}
</a>
