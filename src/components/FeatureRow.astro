---
import { encodeHref } from '../consts';

interface FeatureItem {
  image_path?: string;
  alt?: string;
  title?: string;
  excerpt?: string;
  url?: string;
  btn_label?: string;
  btn_class?: string;
  [k: string]: string | undefined;
}
interface Props {
  features: FeatureItem[];
}
const { features } = Astro.props;

function buttons(f: FeatureItem) {
  const out: { url: string; label: string; ext: boolean }[] = [];
  const add = (url?: string, label?: string) => {
    if (url && label) out.push({ url, label, ext: url.startsWith('http') });
  };
  add(f.url, f.btn_label);
  for (const n of [2, 3, 4, 5]) add(f[`url${n}`], f[`btn_label${n}`]);
  return out;
}
---

<div class="feature__wrapper">
  {
    features.map((f) => (
      <div class="feature__item">
        <div class="archive__item">
          {f.image_path && (
            <div class="archive__item-teaser">
              <img src={f.image_path} alt={f.alt ?? ''} loading="lazy" />
            </div>
          )}
          <div class="archive__item-body">
            {f.title && <h2 class="archive__item-title">{f.title}</h2>}
            {f.excerpt && (
              <div class="archive__item-excerpt">
                <p>{f.excerpt}</p>
              </div>
            )}
            {buttons(f).length > 0 && (
              <div class="archive__item-buttons">
                {buttons(f).map((b) => (
                  <a
                    href={b.ext ? b.url : encodeHref(b.url)}
                    class="btn"
                    {...(b.ext
                      ? { target: '_blank', rel: 'noopener noreferrer' }
                      : {})}
                  >
                    {b.label}
                  </a>
                ))}
              </div>
            )}
          </div>
        </div>
      </div>
    ))
  }
</div>
